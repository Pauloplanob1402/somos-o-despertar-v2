# Copie este arquivo para .env.local e preencha com os valores do seu
# projeto Supabase (Project Settings > API no painel).
#
# Essas duas são públicas por design (prefixo NEXT_PUBLIC_) — a proteção
# real dos dados vem das políticas de RLS definidas em supabase/migrations,
# não do sigilo dessas chaves.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Push notifications (Web Push / VAPID). A chave pública precisa existir
# nas DUAS variáveis abaixo (uma pro navegador, outra pro servidor) — é a
# mesma chave, só duplicada porque só a que tem o prefixo NEXT_PUBLIC_
# chega no navegador. A privada NUNCA leva o prefixo NEXT_PUBLIC_ — é
# secreta. Gere seu próprio par com `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seuemail@exemplo.com

# Service role key do Supabase (Project Settings > API > service_role).
# SECRETA — nunca prefixo NEXT_PUBLIC_, nunca no código, só aqui/no
# painel de variáveis de ambiente do Vercel. Usada só em app/api/push/send
# pra poder ler a inscrição de push de QUALQUER usuário (não só de quem
# está logado na hora), já que quem dispara a notificação é sempre outra
# pessoa (quem comentou/reagiu/orou), não quem vai recebê-la.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (opcional). SEM prefixo NEXT_PUBLIC_ de propósito: essa chave é
# secreta e só pode ser usada no servidor (app/api/...). Se ficar vazia,
# o app funciona normalmente — os recursos de IA (resumo de discussão e
# sugestão de mesas) simplesmente caem no comportamento padrão sem IA.
# Pegue a sua em https://aistudio.google.com/apikey
GEMINI_API_KEY=
